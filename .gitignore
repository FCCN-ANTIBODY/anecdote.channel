_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
# Ignore folders generated by Bundler
.bundle/
vendor/
# Node: the reducer's optional real instrument (@huggingface/transformers). The in-repo model
# lives under models/ (committed, NOT ignored — it is the source of truth). The lockfile is
# environment-specific (installed with --ignore-scripts behind the proxy), so it is not pinned.
node_modules/
package-lock.json

# Generated during deploy (pages.yml): sync-sites.mjs writes these, render.mjs folds the listing
# into the page. Resolved at publish time so they cannot drift from what is actually served.
sites.json
_data/sites.json
_data/listing.json

# render.mjs preview output (the deploy renders --in-place instead)
*.rendered.html
